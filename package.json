{
  "name": "microsite-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Starter for RMP client campaign microsites (Astro + React + Tailwind v4). Fork it for each new site.",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 3011 --host localhost",
    "build": "astro build",
    "preview": "astro preview --port 3011",
    "check": "astro check",
    "ci": "astro check && astro build"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
