---
interface Props { id?: string; tone?: 'surface' | 'alt' | 'brand'; class?: string }
const { id, tone = 'surface', class: className = '' } = Astro.props
const tones = { surface: 'bg-surface', alt: 'bg-surface-2', brand: 'bg-brand text-brand-ink' }
---
<section id={id} class={`py-20 sm:py-28 ${tones[tone]} ${className}`}>
  <div class="container-x"><slot /></div>
</section>
