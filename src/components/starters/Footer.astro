---
/** Starter footer: links from campaign.config.ts plus client/partner logos. */
import campaign from '~/campaign'
const year = new Date().getFullYear()
---
<footer class="bg-ink text-surface">
  <div class="container-x flex flex-col gap-10 py-14 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-display text-2xl font-bold">{campaign.name}</p>
      <p class="mt-2 max-w-md text-sm opacity-70">{campaign.tagline}</p>
      <!-- Client + partner logos go here (white versions), e.g. <img src={logo.src} alt="Client" /> -->
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-7 gap-y-3">
      {campaign.footerNav.map((item) => <a href={item.href} class="font-display text-sm font-semibold uppercase tracking-wide hover:text-accent">{item.label}</a>)}
    </nav>
  </div>
  <div class="border-t border-surface/15">
    <p class="container-x py-5 text-xs opacity-60">© {year} {campaign.name}. Built by Higherin.</p>
  </div>
</footer>
