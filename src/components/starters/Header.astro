---
/**
 * Starter header: logo, nav from campaign.config.ts, CTA (hidden once the
 * campaign closes) and an accessible mobile menu. Restyle freely per client.
 */
import campaign from '~/campaign'
import { getPhase } from '@/lib/campaign'
import Button from './Button.astro'
const phase = getPhase(campaign)
const path = Astro.url.pathname
---
<header class="sticky top-0 z-40 border-b-2 border-line bg-surface/85 backdrop-blur-md">
  <div class="container-x flex h-18 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold" aria-label={`${campaign.name}, home`}>
      <span class="grid size-9 place-items-center rounded-xl bg-brand text-brand-ink" aria-hidden="true">A</span>
      <span class="hidden sm:inline">{campaign.name.split(' ').slice(0, 3).join(' ')}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {campaign.nav.map((item) => (
        <a href={item.href} class:list={['font-display text-sm font-semibold uppercase tracking-wide hover:text-brand', { 'text-brand': path === item.href }]}>{item.label}</a>
      ))}
      {phase === 'open' && <Button href={campaign.cta.href}>{campaign.cta.label}</Button>}
    </nav>

    <button id="menu-toggle" class="md:hidden grid size-11 place-items-center rounded-xl border-2 border-line" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav id="mobile-menu" aria-label="Main (mobile)" class="hidden border-t-2 border-line bg-surface md:hidden">
    <div class="container-x flex flex-col gap-1 py-4">
      {campaign.nav.map((item) => <a href={item.href} class="rounded-lg px-3 py-3 font-display font-semibold uppercase hover:bg-surface-2">{item.label}</a>)}
      {phase === 'open' && <Button href={campaign.cta.href} class="mt-2 self-start">{campaign.cta.label}</Button>}
    </div>
  </nav>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById('menu-toggle')
    const menu = document.getElementById('mobile-menu')
    if (!btn || !menu || btn.dataset.ready) return
    btn.dataset.ready = '1'
    const close = () => { menu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false') }
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false
      btn.setAttribute('aria-expanded', String(open))
    })
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close() })
  }
  document.addEventListener('astro:page-load', setupMenu)
</script>
