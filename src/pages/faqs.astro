---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/starters/Section.astro'
import { byOrder } from '@/lib/campaign'
const faqs = (await getCollection('faqs')).sort(byOrder)
---
<BaseLayout title="FAQs" description="Answers to common questions about the competition.">
  <Section>
    <p class="eyebrow">Help</p>
    <h1 class="mt-3 text-5xl font-bold">Frequently asked questions</h1>
    <div class="mt-12 max-w-3xl space-y-4">
      {faqs.map((f) => (
        <details class="group rounded-card border-[3px] border-line bg-surface p-6 open:shadow-card">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-bold">
            {f.data.question}<span class="text-2xl transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 text-muted">{f.data.answer}</p>
        </details>
      ))}
    </div>
  </Section>
</BaseLayout>
