---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/starters/Button.astro'
---
<BaseLayout title="Thank you" noindex>
  <section class="grid min-h-[70dvh] place-items-center bg-surface-2 px-5 py-24 text-center">
    <div class="max-w-xl" data-reveal>
      <p class="eyebrow">You're in</p>
      <h1 class="mt-4 text-5xl font-bold sm:text-6xl">Thanks for taking part!</h1>
      <p class="mt-6 text-lg text-muted">We'll email you if you're shortlisted. In the meantime, see who else is behind the programme.</p>
      <Button href="/" size="lg" class="mt-10">Back to home</Button>
    </div>
  </section>
  <script>
    import { confetti } from '@/components/wow/confetti'
    document.addEventListener('astro:page-load', () => { if (location.pathname.startsWith('/thanks')) confetti() })
  </script>
</BaseLayout>
